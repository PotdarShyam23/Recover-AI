# Render / Production Backend URL
# In your Render Static Site dashboard -> Environment Variables, add:
# VITE_API_URL=https://your-backend-service.onrender.com
# (Or VITE_API_BASE=https://your-backend-service.onrender.com/api)
#
# Note: In Vite, all client-exposed environment variables must start with VITE_
VITE_API_URL=http://localhost:4001
